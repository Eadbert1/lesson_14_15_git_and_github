<div class="row">
    <div class="col-lg-12">
        <h1 class="text-center">Finance Manager apps</h1>
    </div>
</div>

<div class="row mt-4 mb-4">
    <div class="col-lg-6">
        <h4>income</h4>
        <p class="text-sucsess">Rp.{{income}}</p>
    </div>
    <div class="col-lg-6">
        <h4>outcome</h4>
        <p class="text-danger">Rp.{{outcome}}</p>
    </div>
</div>

<div class="row mt-2 mb-4">
    <div class="col-lg-12 text-center">
        <h4 class="text-warning">Total Balance</h4>
        <p class="text-warning">
            Rp. {{balance}}
        </p>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <h4 class="text-center">Input Finance</h4>
        <form method="post" action="/finance/store">
            <form>
                <div class="mb-3">
                    <label for="transaction_name" class="form-label">Transaction Name</label>
                    <input type="text" class="form-control" id="transaction_name" name="transaction_name"
                        placeholder="Input transsaction name :Buy toys , gear ,games">
                    <div id="emailHelp" class="form-text">We'll never share your email with anyone else.</div>
                </div>
                <div class="mb-3">
                    <label for="price" class="form-label">money</label>
                    <input type="number" class="form-control" id="money" name="money"
                        placeholder="your money/income/outcome">
                </div>
                <div class="mb-3">
                    <label for="transaction type" class="form-label">Transaction type</label>
                    <select class="form-select" aria-label="Default select example" name="transaction_type">
                        <option selected>Open this select menu</option>
                        <option value="income">➕ income</option>
                        <option value="outcome">➖ outcome</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">Submit</button>
            </form>
        </form>
    </div>
</div>
<hr class="my-5">
<div class="row mt-2">
    <div class="col-lg-12">
        <h4 class="text-center mb-3">Transaction History</h4>
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="tabel-dark">
                    <tr>
                        <th>Date</th>
                        <th>Transaction Name</th>
                        <th>Type</th>
                        <th>Amount (Rp)</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each transaction}}
                    <tr>
                        <td>{{this.date}}</td>
                        <td>{{this.transaction_name}}</td>

                        <td>
                            {{#if (eq this.transaction_type "income")}}
                                <span class="badge bg-success">Income</span>
                            {{else}}
                                <span class="badge bg-danger">Outcome</span>
                            {{/if}}

                        </td>
                        <td>{{this.money}}</td>
                    </tr>
                    {{else}}
                        <tr>
                            <td class="text-center" colspan="4">No transaction history</td>
                        </tr>
                {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>